# SkillSwap AI Backend
# Environment variables — copy to .env and fill in real values.

APP_NAME=SkillSwap AI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Supabase PostgreSQL connection string
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./skillswap.db

# JWT — generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-app.vercel.app

# OpenAI-compatible AI provider (OpenAI, Groq, Together, Azure OpenAI, etc.)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_ENABLED=true

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=skillswap

RATE_LIMIT=100/minute
MAX_UPLOAD_SIZE_MB=10
